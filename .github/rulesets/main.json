{
  "name": "Main branch protection",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Backend (ubuntu-24.04)",
            "integration_id": 15368
          },
          {
            "context": "Backend (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "Frontend",
            "integration_id": 15368
          },
          {
            "context": "End-to-end",
            "integration_id": 15368
          },
          {
            "context": "Docker build",
            "integration_id": 15368
          },
          {
            "context": "Agent dispatch policy",
            "integration_id": 15368
          },
          {
            "context": "Windows client",
            "integration_id": 15368
          },
          {
            "context": "Rust dependency audit",
            "integration_id": 15368
          },
          {
            "context": "GLib optimized regression",
            "integration_id": 15368
          },
          {
            "context": "Desktop packages",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
