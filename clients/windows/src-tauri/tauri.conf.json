{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Server Client",
  "version": "0.1.0-alpha.1",
  "identifier": "org.splortch.mediaserver.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Server",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 450
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; media-src http://127.0.0.1:*; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; media-src http://127.0.0.1:*; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A private desktop client for your Media Server",
    "category": "Entertainment",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "version": "0.1.0.1"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../node_modules/react/LICENSE": "licenses/react-LICENSE",
      "../node_modules/react-dom/LICENSE": "licenses/react-dom-LICENSE",
      "../node_modules/scheduler/LICENSE": "licenses/scheduler-LICENSE",
      "../node_modules/@tauri-apps/api/LICENSE-MIT": "licenses/tauri-api-LICENSE-MIT"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
